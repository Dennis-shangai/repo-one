   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "data = pd.DataFrame({\n",
    "    \"Topic\": [\"Python\", \"Git\", \"Pandas\", \"SQL\"],\n",
    "    \"Confidence\": [90, 95, 80, 75]\n",
    "})\n",
    "\n",
    "display(data)\n",
    "data.plot(kind=\"bar\", x=\"Topic\", y=\"Confidence\", legend=False, title=\"Moringa Readiness\")\n",
    "plt.show()\n"
   ]
